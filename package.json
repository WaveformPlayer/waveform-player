{
  "name": "@arraypress/waveform-player",
  "version": "1.30.2",
  "description": "Lightweight, customizable audio player with waveform visualization",
  "type": "module",
  "types": "./types/index.d.ts",
  "main": "dist/waveform-player.cjs",
  "module": "dist/waveform-player.esm.js",
  "unpkg": "dist/waveform-player.min.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/waveform-player.esm.js",
      "require": "./dist/waveform-player.cjs",
      "default": "./dist/waveform-player.esm.js"
    },
    "./no-autoinit": {
      "types": "./types/entry.d.ts",
      "import": "./dist/waveform-player-no-autoinit.esm.js",
      "require": "./dist/waveform-player-no-autoinit.cjs",
      "default": "./dist/waveform-player-no-autoinit.esm.js"
    },
    "./styles.css": "./dist/waveform-player.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "types/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:css && npm run build:iife && npm run build:esm && npm run build:cjs && npm run build:min && npm run build:no-autoinit && npm run build:types",
    "build:css": "esbuild src/css/waveform-player.css --minify --outfile=dist/waveform-player.css",
    "build:iife": "esbuild src/js/index.ts --bundle --format=iife --outfile=dist/waveform-player.js",
    "build:min": "esbuild src/js/index.ts --bundle --format=iife --outfile=dist/waveform-player.min.js --minify",
    "build:no-autoinit": "npm run build:no-autoinit:esm && npm run build:no-autoinit:cjs",
    "build:no-autoinit:esm": "esbuild src/js/entry.ts --bundle --format=esm --outfile=dist/waveform-player-no-autoinit.esm.js --minify",
    "build:no-autoinit:cjs": "esbuild src/js/entry.ts --bundle --format=cjs --outfile=dist/waveform-player-no-autoinit.cjs",
    "build:esm": "esbuild src/js/index.ts --bundle --format=esm --outfile=dist/waveform-player.esm.js --minify",
    "build:cjs": "esbuild src/js/index.ts --bundle --format=cjs --outfile=dist/waveform-player.cjs",
    "dev": "npm run build:css && esbuild src/js/index.ts --bundle --format=iife --outfile=dist/waveform-player.js --watch",
    "dev:css": "esbuild src/css/waveform-player.css --outfile=dist/waveform-player.css --watch",
    "dev:demo": "npm run build:css && concurrently \"npm run dev\" \"npm run dev:css\"",
    "size": "npm run build:min && npm run build:css && echo 'JS:' && gzip -c dist/waveform-player.min.js | wc -c && echo 'CSS:' && gzip -c dist/waveform-player.css | wc -c",
    "serve": "npx http-server -p 8000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "node test/visual/theme-matrix.mjs",
    "test:pack": "npm run build && node test/pack/verify.mjs",
    "prepublishOnly": "npm run test && npm run build",
    "build:types": "rm -rf types && tsc -p tsconfig.build.json"
  },
  "keywords": [
    "audio",
    "player",
    "waveform",
    "visualization",
    "music",
    "sound",
    "html5",
    "web-audio",
    "media-session",
    "audio-player",
    "waveform-visualization",
    "soundcloud",
    "podcast-player",
    "audio-visualization",
    "bpm-detection"
  ],
  "author": "ArrayPress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaveformPlayer/waveform-player.git"
  },
  "bugs": {
    "url": "https://github.com/WaveformPlayer/waveform-player/issues"
  },
  "homepage": "https://waveformplayer.com",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/arraypress"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "*.css",
    "./dist/waveform-player.esm.js",
    "./dist/waveform-player.cjs",
    "./dist/waveform-player-no-autoinit.esm.js",
    "./dist/waveform-player-no-autoinit.cjs",
    "./dist/waveform-player.js",
    "./dist/waveform-player.min.js",
    "./src/js/index.ts",
    "./src/js/entry.ts"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
